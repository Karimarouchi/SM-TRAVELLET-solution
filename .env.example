# ── Domaine public (enregistrement DNS de type A vers l'IP du VPS) ──
# Un seul nom : smtravel.fr
# Racine + www : smtravel.fr www.smtravel.fr
# Pas encore de domaine (HTTP seulement, IP) : :80
SITE_ADDRESS=smtravel.fr
APP_PUBLIC_URL=https://www.smtravel.fr
CORS_ORIGIN=https://www.smtravel.fr
ACME_EMAIL=smtravel.contact@gmail.com

# ── PostgreSQL ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=sm_travel

# ── API ──
PORT=3001
NODE_ENV=production
JWT_SECRET=changez-moi-64-caracteres-minimum
JWT_EXPIRES_IN=7d

# Premier compte administrateur (créé au premier démarrage uniquement)
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=changez-moi-mot-de-passe-fort

# Emails (inscription, mot de passe oublié). Sans ça, l'app tourne mais les mails ne partent pas.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=SM Travel

# Optionnel — Google Calendar, WhatsApp, sauvegarde Supabase
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
SUPABASE_DATABASE_URL=
BACKUP_ALERT_EMAIL=
