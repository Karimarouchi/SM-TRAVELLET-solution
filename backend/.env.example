# Modèle de backend/.env — copiez ce fichier en backend/.env et remplissez les
# valeurs. Ne committez JAMAIS le vrai backend/.env.

PORT=3001
DATABASE_URL=postgresql://postgres:MOT_DE_PASSE@localhost:5432/sm_travel
JWT_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5174
# Adresse du site utilisée dans les liens envoyés aux étudiants (codes WhatsApp).
# En local : http://localhost:5174 — en production : https://sm.antigoneinterne.agency
APP_PUBLIC_URL=https://sm.antigoneinterne.agency

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=SM Travel

ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Sauvegarde Supabase (optionnel, voir backend/scripts/README.md)
SUPABASE_DATABASE_URL=
BACKUP_ALERT_EMAIL=
PG_DUMP_PATH=
PG_RESTORE_PATH=

# Google Calendar : liens Meet créés automatiquement (optionnel, voir backend/GOOGLE_CALENDAR.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Vide = APP_PUBLIC_URL + /api/google/callback
GOOGLE_REDIRECT_URI=

# WhatsApp Business Cloud API (optionnel, voir backend/WHATSAPP.md)
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1185838064603179
WHATSAPP_GRAPH_VERSION=v23.0
